#   DATABASE_URL="file:./dev.db"
# For production (Supabase Postgres pooler URL):
#   DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="file:./dev.db"

